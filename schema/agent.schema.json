{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acowork.dev/schemas/agent.schema.json",
  "title": "ACoworkAgents index entry",
  "description": "One entry of the generated index.json. The file names and field names are intentionally aligned with the main repo's dev/common/sync-agent-hub.py output so that the website pipeline can consume both without special-casing.",
  "type": "object",
  "required": [
    "agent_id",
    "version",
    "name",
    "display_name",
    "role",
    "description",
    "author",
    "category",
    "category_label",
    "tier",
    "tags",
    "skills",
    "publisher",
    "source",
    "package"
  ],
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "runtime_version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "category_label": {
      "type": "string"
    },
    "tier": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "high_risk_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publisher": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "affiliation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "affiliation": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "homepage": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "description": "Where the agent lives in this repository.",
      "required": [
        "owner",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      }
    },
    "package": {
      "type": "object",
      "required": [
        "file",
        "size_bytes",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "description": "Provenance of the package signature. 'official-channel' means the package was signed by a key listed in registry/trusted-keys.json AND has not been altered since signing. This is a distribution-channel marker, NOT an endorsement of the agent's quality, and it is never rendered as a trust badge. 'third-party' means the signature verified but the signer is not an official channel key. 'unsigned' means no signature. See docs/trust-model.md.",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "official-channel",
            "third-party",
            "unsigned"
          ]
        },
        "key_fingerprint": {
          "type": "string",
          "description": "SHA-256 of the signer's raw public key, hex-encoded. Matches the value printed by the main repo's acowork-verify."
        },
        "signing_time": {
          "type": "string"
        },
        "catalog_digest_covered": {
          "type": "boolean",
          "description": "Always true for signed packages: category/tier/tags live in manifest.toml, which is inside the digest list. There is no case where they are unsigned."
        }
      }
    },
    "avatar": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
